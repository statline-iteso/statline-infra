          "expr": "sum(rate(statline_http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[5m])) / sum(rate(statline_http_requests_total{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "5xx",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
