        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(statline_http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
