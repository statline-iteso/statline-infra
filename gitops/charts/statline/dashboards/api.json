    {
      "id": 11,
      "type": "timeseries",
      "title": "API CPU vs HPA target",
      "description": "CPU usage as a share of the container CPU request (the HPA utilization basis), against the HPA target.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\".*-api-.*\",container=\"api\"}[5m])) / sum(kube_pod_container_resource_requests{namespace=\"$namespace\",pod=~\".*-api-.*\",container=\"api\",resource=\"cpu\"})",
