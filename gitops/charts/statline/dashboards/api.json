          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_horizontalpodautoscaler_spec_target_metric{namespace=\"$namespace\",horizontalpodautoscaler=~\".*-api\",metric_name=\"cpu\"}",
          "legendFormat": "HPA target %",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
