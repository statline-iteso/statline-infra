%% Diagrama de la solución (entregable 1). Render: make diagram  →  docs/solucion.png
%% Verde = implementado · Gris punteado = pendiente (segunda mitad)
flowchart LR
    classDef done fill:#d3f9d8,stroke:#2b8a3e,stroke-width:2px,color:#0b3d17
    classDef planned fill:#f1f3f5,stroke:#868e96,stroke-width:1px,stroke-dasharray:5 4,color:#495057
    classDef ext fill:#fff4e6,stroke:#e8590c,color:#5c2a00

    subgraph LEG["Leyenda"]
        direction TB
        L1["Implementado<br/>(código, imagen o módulo Terraform;<br/>aún sin aplicar en Azure)"]:::done
        L2["Pendiente (segunda mitad)"]:::planned
    end

    USR(["Usuario<br/>navegador"])

    subgraph GH["GitHub · statline-iteso"]
        direction TB
        CI["GitHub Actions ci.yml<br/>lint · tests ≥70 % · build · Trivy"]:::done
        CD["cd.yml<br/>Docker Hub + etiqueta en gitops/"]:::planned
        GITOPS[("gitops/<br/>chart Helm + values")]:::planned
    end

    HUB[("Docker Hub<br/>statline/web · api<br/>predicciones · ingesta")]:::planned

    subgraph AZ["Azure · rg-statline · Terraform"]
        direction TB
        subgraph NET["vnet-statline 10.0.0.0/16"]
            direction TB
            subgraph AKS["AKS 1.30 · 2→4 × Standard_B2s"]
                direction TB
                subgraph PLAT["ns plataforma"]
                    ING["ingress-nginx<br/>+ cert-manager"]:::planned
                    ARGO["Argo CD"]:::planned
                    PROM["Prometheus<br/>Grafana"]:::planned
                    REDIS[("Redis 7")]:::planned
                end
                subgraph APP["ns statline-staging / statline-prod"]
                    WEB["web ×2<br/>React 18 + nginx"]:::done
                    API["api 2–6<br/>Node 20 · Express · Prisma"]:::done
                    PRED["predicciones 1–4<br/>FastAPI · scikit-learn"]:::planned
                    CJB["CronJob ingesta-basquetbol<br/>0 8 * * *"]:::done
                    CJA["CronJob ingesta-americano<br/>0 8 * * 2"]:::planned
                    CJF["CronJob ingesta-futbol<br/>0 8 * * 1,5"]:::planned
                end
            end
            PG[("PostgreSQL 16 Flexible<br/>B_Standard_B1ms · privado<br/>JSONB + GIN")]:::done
        end
        KV["Key Vault<br/>+ CSI driver"]:::planned
        LA["Log Analytics"]:::planned
        ST[("Storage<br/>tfstate")]:::done
    end

    subgraph EXT["Proveedores"]
        direction TB
        APIS["API-Sports<br/>basketball · american-football · football"]:::ext
        BDL["balldontlie.io · TheSportsDB<br/>(respaldo)"]:::planned
    end

    USR -->|HTTPS| ING
    ING -->|/| WEB
    ING -->|/api| API
    API -->|SQL| PG
    API -->|HTTP interno| PRED
    API -.-> REDIS
    PRED -->|SQL| PG
    CJB -->|HTTPS| APIS
    CJB -->|upsert + JSON Schema| PG
    CJA -.-> APIS
    CJF -.-> APIS
    CJB -.-> BDL
    KV -.->|secretos| APP
    PROM -.->|/metrics| APP
    CI --> CD --> HUB
    CD --> GITOPS
    ARGO -.->|sync| GITOPS
    ARGO -.->|despliega| APP
    AKS -.-> LA
