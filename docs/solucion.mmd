%% Diagrama de la solución (entregable 1). Render: make diagram  →  docs/solucion.png
%% Verde = desplegado en AWS (staging y prod, v1.2.0) · Naranja = servicio externo · Línea punteada = opcional o respaldo
flowchart LR
    classDef done fill:#d3f9d8,stroke:#2b8a3e,stroke-width:2px,color:#0b3d17
    classDef ext fill:#fff4e6,stroke:#e8590c,color:#5c2a00

    subgraph LEG["Leyenda"]
        direction TB
        L1["Desplegado en AWS<br/>(staging y prod, v1.2.0)"]:::done
        L2["Servicio externo<br/>(proveedores de datos, Sentry)"]:::ext
        L3["Línea punteada: opcional<br/>(Redis) o respaldo"]
    end

    USR(["Usuario<br/>navegador"])

    subgraph GH["GitHub · statline-iteso"]
        direction TB
        CI["GitHub Actions ci.yml<br/>lint · tests ≥70 % · build · Trivy"]:::done
        CD["cd.yml<br/>Docker Hub + etiqueta en gitops/"]:::done
        GITOPS[("gitops/<br/>chart Helm + values")]:::done
    end

    HUB[("Docker Hub<br/>pardosito/web · api<br/>predicciones · ingesta")]:::done

    subgraph AWS["AWS Learner Lab · us-east-1 · Terraform"]
        direction TB
        subgraph NET["vpc-statline 10.0.0.0/16"]
            direction TB
            subgraph EKS["EKS 1.35 · LabRole · 2 × t3.medium"]
                direction TB
                subgraph PLAT["ns plataforma"]
                    ING["ingress-nginx (NLB + IP elástica)<br/>+ cert-manager"]:::done
                    ARGO["Argo CD"]:::done
                    PROM["Prometheus<br/>Grafana"]:::done
                    REDIS[("Redis 7")]:::done
                    ESO["External Secrets"]:::done
                end
                subgraph APP["ns statline-staging / statline-prod"]
                    WEB["web ×2<br/>React 18 + nginx"]:::done
                    API["api 2–6<br/>Node 20 · Express · Prisma"]:::done
                    PRED["predicciones 1–4<br/>FastAPI · scikit-learn"]:::done
                    CJB["CronJob ingesta-basquetbol<br/>0 8 * * *"]:::done
                    CJA["CronJob ingesta-americano<br/>0 8 * * 2"]:::done
                    CJF["CronJob ingesta-futbol<br/>0 8 * * 1,5"]:::done
                end
            end
            PG[("RDS PostgreSQL 16<br/>db.t3.micro · subredes privadas<br/>JSONB + GIN")]:::done
        end
        KV["SSM Parameter Store<br/>SecureString"]:::done
        COG["Cognito<br/>un user pool por ambiente"]:::done
        LA["CloudWatch Logs"]:::done
        ST[("S3<br/>tfstate")]:::done
    end

    SEN["Sentry · APM<br/>errores · trazas · Crons"]:::ext

    subgraph EXT["Proveedores"]
        direction TB
        APIS["API-Sports<br/>basketball · american-football · football"]:::ext
        BDL["balldontlie.io · TheSportsDB<br/>(respaldo)"]:::ext
    end

    USR -->|"HTTPS · nip.io"| ING
    USR -->|"inicio de sesión · registro"| COG
    API -->|"llaves públicas (JWKS)"| COG
    APP -->|"errores y trazas"| SEN
    ING -->|/| WEB
    ING -->|/api| API
    API -->|SQL| PG
    API -->|HTTP interno| PRED
    API -.->|caché opcional| REDIS
    PRED -->|SQL| PG
    CJB -->|HTTPS| APIS
    CJB -->|upsert + JSON Schema| PG
    CJA -->|HTTPS| APIS
    CJF -->|HTTPS| APIS
    CJB -.->|respaldo| BDL
    CJA -.->|respaldo| BDL
    CJF -.->|respaldo| BDL
    CJA -->|upsert + JSON Schema| PG
    CJF -->|upsert + JSON Schema| PG
    KV -->|LabRole| ESO
    ESO -->|statline-secrets| APP
    PROM -->|/metrics| APP
    CI --> CD --> HUB
    CD --> GITOPS
    ARGO -->|sync| GITOPS
    ARGO -->|despliega| APP
    EKS -->|logs del control plane| LA
    PG -->|logs| LA
